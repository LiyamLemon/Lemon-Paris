/* ── Helpers ── */
function getSlide(pid) {
  const sl = document.getElementById('slider-'+pid);
  if (!sl) return '';
  const slide = sl.querySelector('.slide');
  return slide ? slide.src : '';
}
function fmtPrice(n) { return n.toFixed(2).replace('.',',') + ' €'; }
async function updateBadge() {
  try {
    const res = await fetch('/cart.js');
    const cart = await res.json();
    const el = document.getElementById('cartCount');
    if (el) { el.textContent = cart.item_count; el.style.display = cart.item_count > 0 ? 'flex' : 'none'; }
  } catch(e) {}
}

/* ── Add to cart ── */

const SHOPIFY_HANDLES = {
  'e1': 'ensemble-riveira-rose',
  'e2': 'ensemble-riveira-bleu',
  'e3': 'ensemble-monegasque',
  'e4': 'ensemble-marbella',
  'ts_rose': 't-shirt-riviera-rose',
  'ts_bleu': 't-shirt-riviera-bleu',
  'sh_rose': 'short-riviera-rose',
  'sh_bleu': 'short-riviera-bleu',
  'cap_bleu': 'casquette-riviera-bleu',
  'cap_rose': 'casquette-riviera-rose'
};
async function addToCart(name, price) {
  const modal = document.querySelector('.modal-overlay.active');
  const sz = modal ? modal.querySelector('.size-btn.active') : null;
  if (!sz) {
    if (modal) modal.querySelectorAll('.size-btn').forEach(b=>{
      b.style.animation='none'; b.offsetHeight; b.style.animation='sizeshake 0.35s ease';
    });
    return;
  }
  let pid = null;
  ['e1','e2','e3','e4','ts_rose','ts_bleu','sh_rose','sh_bleu','cap_bleu','cap_rose'].forEach(id=>{
    const mel=document.getElementById('modal-'+id); if(mel && mel.classList.contains('active')) pid=id;
  });
  if (!pid) return;
  const handle = SHOPIFY_HANDLES[pid];
  const size = sz.textContent.replace(/<[^>]*>/g,'').trim();
  const btn = modal ? modal.querySelector('.btn-buy') : null;
  if (handle) {
    if (btn) btn.disabled = true;
    try {
      const res = await fetch('/products/' + handle + '.js');
      const product = await res.json();
      const variant = product.variants.find(v => v.title.toLowerCase() === size.toLowerCase()) || product.variants[0];
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({id: variant.id, quantity: 1})
      });
      await updateBadge();
      if (btn) {
        btn.disabled = false;
        btn.classList.add('success');
        const sp = btn.querySelector('span'); if(sp) sp.textContent='✓ Ajouté'; else btn.textContent='✓ Ajouté';
        setTimeout(()=>{ btn.classList.remove('success'); const s=btn.querySelector('span'); if(s) s.textContent='Ajouter au panier'; else btn.textContent='Ajouter au panier'; }, 1800);
      }
      closeModal(pid);
      await renderCartDrawer(); openCart();
    } catch(e) { console.error('Cart error:', e); if(btn) btn.disabled = false; }
    return;
  }
}

async function buyNow(name, price) {
  const modal = document.querySelector('.modal-overlay.active');
  const sz = modal ? modal.querySelector('.size-btn.active') : null;
  if (!sz) {
    if (modal) modal.querySelectorAll('.size-btn').forEach(b=>{
      b.style.animation='none'; b.offsetHeight; b.style.animation='sizeshake 0.35s ease';
    });
    return;
  }
  let pid = null;
  ['e1','e2','e3','e4','ts_rose','ts_bleu','sh_rose','sh_bleu','cap_bleu','cap_rose'].forEach(id=>{
    const mel=document.getElementById('modal-'+id); if(mel && mel.classList.contains('active')) pid=id;
  });
  if (!pid) return;
  const handle = SHOPIFY_HANDLES[pid];
  const size = sz.textContent.replace(/<[^>]*>/g,'').trim();
  if (handle) {
    try {
      const res = await fetch('/products/' + handle + '.js');
      const product = await res.json();
      const variant = product.variants.find(v => v.title.toLowerCase() === size.toLowerCase()) || product.variants[0];
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({id: variant.id, quantity: 1})
      });
      window.location.href = '/checkout';
    } catch(e) { console.error('Buy now error:', e); }
    return;
  }
}

async function shopifyChangeQty(variantId, newQty) {
  await fetch('/cart/change.js', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({id: variantId, quantity: Math.max(0, newQty)})
  });
  await updateBadge();
  await renderCartDrawer();
}

/* ── Cart Drawer ── */
async function renderCartDrawer() {
  const body=document.getElementById('cartBody');
  const footer=document.getElementById('cartFooter');
  if(!body) return;
  let cart;
  try { const r=await fetch('/cart.js'); cart=await r.json(); } catch(e) { return; }
  if(cart.item_count===0){
    body.innerHTML='<div class="cart-empty"><p class="cart-empty-title">Votre panier est vide</p><p class="cart-empty-sub">Découvrez la collection</p></div>';
    if(footer) footer.style.display='none';
    return;
  }
  const itemsHtml=cart.items.map(it=>`
    <div class="cart-item">
      ${it.image?`<img class="cart-item-img" src="${it.image}" alt="${it.title}"/>`:''}
      <div class="cart-item-info">
        <p class="cart-item-name">${it.product_title}</p>
        ${it.variant_title&&it.variant_title!=='Default Title'?`<p class="cart-item-size">Taille : ${it.variant_title}</p>`:''}
        <p class="cart-item-price">${(it.price/100).toFixed(2).replace('.',',')} €</p>
        <div class="cart-item-qty">
          <button class="cart-qty-btn" onclick="shopifyChangeQty('${it.key}',${it.quantity-1})">−</button>
          <span class="cart-qty-num">${it.quantity}</span>
          <button class="cart-qty-btn" onclick="shopifyChangeQty('${it.key}',${it.quantity+1})">+</button>
        </div>
        <button class="cart-item-remove" onclick="shopifyChangeQty('${it.key}',0)">Supprimer</button>
      </div>
    </div>`).join('');
  body.innerHTML=itemsHtml;
  const el=document.getElementById('cartTotalPrice');
  if(el) el.textContent=(cart.total_price/100).toFixed(2).replace('.',',')+' €';
  if(footer) footer.style.display='block';
}

async function openCart(){
  const overlay=document.getElementById('cartOverlay');
  const drawer=document.getElementById('cartDrawer');
  if(!overlay||!drawer) return;
  overlay.classList.add('open'); drawer.classList.add('open');
  requestAnimationFrame(()=>overlay.classList.add('visible'));
  document.body.style.overflow='hidden';
  await renderCartDrawer();
}
function closeCart(){
  const overlay=document.getElementById('cartOverlay');
  const drawer=document.getElementById('cartDrawer');
  if(!overlay||!drawer) return;
  overlay.classList.remove('visible'); drawer.classList.remove('open');
  setTimeout(()=>overlay.classList.remove('open'),350);
  document.body.style.overflow='';
}

/* ── Checkout ── */
let checkoutStep=1;

function openCheckout(){
  closeCart();
  if(cartItems.length===0) return;
  // Copy logo src to checkout
  const logoSrc=document.querySelector('.hero-logo-img')||document.querySelector('.shf-logo-img');
  const chLogo=document.getElementById('checkoutLogo');
  if(chLogo&&logoSrc) chLogo.src=logoSrc.src;
  checkoutStep=1;
  renderCheckout();
  document.getElementById('checkoutOverlay').classList.add('open');
  document.body.style.overflow='hidden';
}
function closeCheckout(){
  document.getElementById('checkoutOverlay').classList.remove('open');
  document.body.style.overflow='';
}

function setProgress(step){
  [1,2,3].forEach(n=>{
    const el=document.getElementById('cps'+n);
    el.classList.remove('active','done');
    if(n<step) el.classList.add('done');
    else if(n===step) el.classList.add('active');
  });
}

function renderCheckout(){
  setProgress(checkoutStep);
  const content=document.getElementById('checkoutContent');
  if(checkoutStep===1) renderCheckoutCart(content);
  else if(checkoutStep===2) renderCheckoutForm(content);
  else renderCheckoutConfirm(content);
  document.getElementById('checkoutPage').scrollTop=0;
  document.getElementById('checkoutOverlay').scrollTop=0;
}

