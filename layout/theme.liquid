function renderCheckoutConfirm(content){
  const orderNum='LP-'+Math.floor(10000+Math.random()*90000);
  content.innerHTML=`
    <div class="co-confirm">
      <div class="co-confirm-icon">✓</div>
      <h1 class="co-confirm-title">Commande confirmée</h1>
      <p class="co-confirm-order">Commande ${orderNum}</p>
      <p class="co-confirm-sub">Merci pour votre confiance.<br>Vous recevrez une confirmation par email.<br><br>
      Lemon Paris — une marque pour ceux<br>qui construisent quelque chose de grand.</p>
      <button class="co-btn-primary" style="margin-top:40px" onclick="cartItems=[];updateBadge();closeCheckout();">Retour à la boutique</button>
    </div>`;
  cartItems=[]; updateBadge();
}

function coChangeQty(key,delta){
  const it=cartItems.find(i=>i.key===key);
  if(!it) return;
  it.qty+=delta;
  if(it.qty<=0) cartItems=cartItems.filter(i=>i.key!==key);
  updateBadge(); renderCheckout();
}
function coRemove(key){ cartItems=cartItems.filter(i=>i.key!==key); updateBadge(); renderCheckout(); }

/* Size button span wrap */
document.querySelectorAll('.size-btn').forEach(btn=>{
  if(!btn.querySelector('span')) btn.innerHTML='<span>'+btn.textContent+'</span>';
});

/* ── Existing functions (keep) ── */
function switchModal(newId){['e1','e2','e3','e4','e5','ts_rose','ts_bleu','sh_rose','sh_bleu','cap_bleu','cap_rose'].forEach(id=>{ const el=document.getElementById('modal-'+id); if(el) el.classList.remove('active');});document.getElementById('modal-'+newId).classList.add('active');mSlideTo(newId,0);;fillUpsellImages(document.getElementById('modal-'+newId));}

// Init
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.modal-overlay').forEach(function(m) {
    m.style.display='none';
    fillUpsellImages(m);
  });
});

