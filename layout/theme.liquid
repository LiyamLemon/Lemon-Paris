<meta name="twitter:image" content="{{ 'img-002.jpg' | asset_url }}"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;0,400;1,200;1,300&family=Montserrat:wght@200;300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--white:#FFFFFF;--cream:#FAFAF8;--light:#F5F3EF;--gold:#C9AA6A;--dark:#111111;--gray:#6B6B6B;--gray-light:#D4D4D4;--fd:'Cormorant Garamond',serif;--fb:'Montserrat',sans-serif}
html{scroll-behavior:smooth}
body{font-family:var(--fb);background:var(--white);color:var(--dark);overflow-x:hidden}

/* REVEAL */
.reveal{opacity:0;transform:translateY(20px);transition:opacity 0.7s cubic-bezier(0.22,1,0.36,1),transform 0.7s cubic-bezier(0.22,1,0.36,1);will-change:opacity,transform}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-delay-1{transition-delay:0.08s}.reveal-delay-2{transition-delay:0.16s}.reveal-delay-3{transition-delay:0.24s}.reveal-delay-4{transition-delay:0.32s}

/* HERO */
#hero{position:relative;width:100%;height:100vh;min-height:640px;overflow:hidden;display:flex;flex-direction:column}
.hero-bg-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 20%;transform:scale(1.03);animation:heroZoom 12s cubic-bezier(0.25,0.46,0.45,0.94) forwards;image-rendering:-webkit-optimize-contrast;image-rendering:crisp-edges;will-change:transform}
@keyframes heroZoom{0%{transform:scale(1.03)}100%{transform:scale(1.0)}}
.hero-bg-img-mobile{display:none}@media(max-width:768px){.hero-bg-img{display:none}.hero-bg-img-mobile{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;image-rendering:-webkit-optimize-contrast;will-change:transform}}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0.25) 0%,rgba(0,0,0,0.08) 35%,rgba(0,0,0,0.18) 65%,rgba(0,0,0,0.55) 100%);z-index:1}
.hero-header{position:relative;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:22px 28px}
.hero-logo-img{height:44px;width:auto;display:block;filter:invert(1);opacity:0;animation:fadeUp 0.9s cubic-bezier(0.22,1,0.36,1) 0.2s forwards}
.shf-logo-img{height:44px;width:auto;display:block}
@keyframes fadeUp{0%{opacity:0;transform:translateY(20px)}100%{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{0%{opacity:0}100%{opacity:1}}
.hero-menu-btn{background:none;border:none;cursor:pointer;display:flex;flex-direction:column;gap:6px;padding:4px}
.hero-menu-btn span{display:block;width:26px;height:1.5px;background:var(--white)}
.hero-content{position:relative;z-index:5;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:space-between;text-align:center;padding:10px 24px 48px}
.hero-center{display:flex;flex-direction:column;align-items:center;margin-top:auto;margin-bottom:auto;padding-top:30px}
.hero-main-title{font-family:var(--fb);font-size:clamp(52px,11vw,110px);font-weight:300;letter-spacing:clamp(8px,2vw,22px);line-height:1;color:var(--white);margin-bottom:6px;opacity:0;animation:fadeUp 1s cubic-bezier(0.22,1,0.36,1) 0.5s forwards}
.hero-main-subtitle-word{font-family:var(--fb);font-size:clamp(18px,3.5vw,36px);font-weight:300;letter-spacing:clamp(10px,3vw,28px);color:var(--white);margin-bottom:20px;opacity:0;animation:fadeUp 1s cubic-bezier(0.22,1,0.36,1) 0.7s forwards}
.hero-phrase{font-family:var(--fd);font-size:clamp(14px,2vw,20px);font-weight:300;font-style:italic;color:rgba(255,255,255,0.82);letter-spacing:0.5px;line-height:1.6;max-width:400px;opacity:0;animation:fadeUp 1s cubic-bezier(0.22,1,0.36,1) 0.9s forwards}
.hero-buttons{display:flex;flex-direction:column;align-items:center;gap:12px;width:100%;opacity:0;animation:fadeUp 0.9s cubic-bezier(0.22,1,0.36,1) 1.3s forwards}
.hero-btn-primary{font-family:var(--fb);font-size:10px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--dark);background:rgba(255,255,255,0.92);text-decoration:none;padding:16px 0;width:min(440px,85vw);display:block;text-align:center;border:1px solid rgba(255,255,255,0.9);transition:background .3s,color .3s,transform .3s}
.hero-btn-primary:hover{background:var(--gold);color:var(--white);border-color:var(--gold);transform:translateY(-2px)}
.hero-btn-secondary{font-family:var(--fb);font-size:10px;font-weight:400;letter-spacing:4px;text-transform:uppercase;color:rgba(255,255,255,0.88);background:transparent;text-decoration:none;padding:15px 0;width:min(440px,85vw);display:block;text-align:center;border:1px solid rgba(255,255,255,0.45);transition:border-color .3s,background .3s,transform .3s}
.hero-btn-secondary:hover{border-color:var(--white);background:rgba(255,255,255,0.1);transform:translateY(-2px)}
.hero-scroll{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);z-index:5;display:flex;flex-direction:column;align-items:center;gap:9px;opacity:0;animation:fadeIn 1s ease 2.2s forwards}
.hero-scroll-label{font-family:var(--fb);font-size:8px;font-weight:300;letter-spacing:5px;text-transform:uppercase;color:rgba(255,255,255,0.45)}
.hero-scroll-line{width:1px;height:44px;background:rgba(255,255,255,0.2);position:relative;overflow:hidden}
.hero-scroll-line::after{content:'';position:absolute;top:-100%;left:0;width:100%;height:100%;background:rgba(255,255,255,0.7);animation:scrollAnim 2s ease infinite}
@keyframes scrollAnim{0%{top:-100%}100%{top:100%}}

/* FIXED HEADER */
.site-header{position:fixed;top:0;left:0;right:0;z-index:100;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,0.96);backdrop-filter:blur(14px);border-bottom:1px solid rgba(0,0,0,0.05);transform:translateY(-100%);transition:transform .45s cubic-bezier(0.22,1,0.36,1)}
.site-header.visible{transform:translateY(0)}
.shf-logo{display:flex;align-items:center;text-decoration:none}
.shf-logo-img{height:42px;width:auto}
.shf-nav{display:flex;gap:34px;align-items:center}
.shf-nav a{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--dark);text-decoration:none;transition:color .3s}
.shf-nav a:hover{color:var(--gold)}
.shf-cta{background:var(--dark);color:var(--white)!important;padding:10px 22px}
.shf-cta:hover{background:var(--gold)!important}

/* MOBILE NAV */
.mobile-nav{display:none;position:fixed;inset:0;background:rgba(10,10,10,0.97);z-index:200;flex-direction:column;align-items:center;justify-content:center;gap:40px}
.mobile-nav.open{display:flex}
.mobile-nav a{font-family:var(--fb);font-size:12px;font-weight:300;letter-spacing:6px;text-transform:uppercase;color:var(--white);text-decoration:none;transition:color .3s}
.mobile-nav a:hover{color:var(--gold)}
.mobile-nav-close{position:absolute;top:28px;right:28px;background:none;border:none;color:var(--white);font-size:24px;cursor:pointer}

/* REASSURANCE */
#reassurance{padding:52px 50px;background:var(--white);border-bottom:1px solid rgba(0,0,0,0.06)}
.reassurance-inner{max-width:900px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:0}
.reassurance-item{display:flex;flex-direction:column;align-items:center;text-align:center;flex:1;padding:0 32px;position:relative}
.reassurance-item+.reassurance-item::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:1px;height:36px;background:rgba(0,0,0,0.1)}
.reassurance-icon{font-size:18px;margin-bottom:10px;color:var(--dark);line-height:1}
.reassurance-stars{color:var(--gold);font-size:13px;letter-spacing:2px;margin-bottom:8px}
.reassurance-label{font-family:var(--fb);font-size:11px;font-weight:500;letter-spacing:2px;color:var(--dark);text-transform:uppercase;margin-bottom:3px}
.reassurance-sub{font-family:var(--fb);font-size:10px;font-weight:300;letter-spacing:1px;color:var(--gray)}

/* NEWSLETTER */
#newsletter{padding:80px 50px;background:var(--dark);text-align:center}
.nl-eye{font-size:9px;font-weight:500;letter-spacing:6px;text-transform:uppercase;color:var(--gold);margin-bottom:16px}
.nl-title{font-family:var(--fd);font-size:clamp(28px,5vw,52px);font-weight:300;color:var(--white);margin-bottom:10px}
.nl-sub{font-size:12px;font-weight:300;color:rgba(255,255,255,0.4);margin-bottom:36px}
.nl-form{display:flex;max-width:440px;margin:0 auto;border:1px solid rgba(201,170,106,0.4)}
.nl-input{flex:1;background:transparent;border:none;outline:none;padding:15px 18px;font-family:var(--fb);font-size:12px;color:var(--white)}
.nl-input::placeholder{color:rgba(255,255,255,0.3)}
.nl-btn{background:var(--gold);color:var(--white);border:none;padding:15px 24px;font-family:var(--fb);font-size:10px;font-weight:600;letter-spacing:3px;text-transform:uppercase;cursor:pointer;transition:background .3s}
.nl-btn:hover{background:#b8962f}

/* COLLECTION */
#collection{padding:90px 40px;background:var(--white)}
.sec-header{text-align:center;margin-bottom:56px}
.sec-eye{font-size:9px;font-weight:500;letter-spacing:6px;text-transform:uppercase;color:var(--gold);margin-bottom:10px}
.sec-title{font-family:var(--fd);font-size:clamp(34px,6vw,60px);font-weight:300;color:var(--dark);line-height:1}
.sec-title em{font-style:italic;color:var(--gold)}
.products-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:1400px;margin:0 auto;width:100%}
.product-card{cursor:pointer;opacity:0;transform:translateY(24px);transition:opacity 0.7s cubic-bezier(0.22,1,0.36,1),transform 0.7s cubic-bezier(0.22,1,0.36,1)}
.product-card.visible{opacity:1;transform:translateY(0)}
.product-card:nth-child(1){transition-delay:0s}.product-card:nth-child(2){transition-delay:0.1s}.product-card:nth-child(3){transition-delay:0.2s}.product-card:nth-child(4){transition-delay:0s}.product-card:nth-child(5){transition-delay:0.1s}
.product-img-wrap{position:relative;aspect-ratio:2/3;overflow:hidden;background:var(--light);margin-bottom:18px;cursor:pointer}
@supports not (aspect-ratio: 1){.product-img-wrap::before{content:'';display:block;padding-top:150%}}
.slider{position:absolute;inset:0}
.slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;opacity:0;transition:opacity .45s ease,transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94)}
.slide.active{opacity:1}
.product-card:hover .product-img-wrap .slide.active{transform:scale(1.05)}
.slide-dots{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);display:flex;gap:6px;z-index:5}
.sdot{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,0.5);cursor:pointer;transition:background .3s;border:1px solid rgba(255,255,255,0.6);touch-action:manipulation}
.sdot.active{background:var(--white)}
.slide-prev,.slide-next{position:absolute;top:50%;transform:translateY(-50%);z-index:5;background:rgba(255,255,255,0.88);border:none;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--dark);opacity:0;transition:opacity .2s;border-radius:50%}
.slide-prev{left:10px}.slide-next{right:10px}
.product-img-wrap:hover .slide-prev,.product-img-wrap:hover .slide-next{opacity:1}
.product-badge{position:absolute;top:12px;left:12px;z-index:3;background:var(--dark);color:var(--white);font-size:8px;font-weight:600;letter-spacing:3px;text-transform:uppercase;padding:4px 10px}
.product-badge.new{background:var(--gold)}
.product-info{padding:0 2px}
.product-collection{font-size:9px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:5px}
.product-name{font-family:var(--fd);font-size:19px;font-weight:400;color:var(--dark);margin-bottom:8px}
.product-price{font-family:var(--fd);font-size:20px;font-weight:600;color:var(--dark)}

/* MODAL */
.modal-overlay{display:none;position:fixed;inset:0;width:100%;height:100%;background:rgba(0,0,0,0.88);z-index:9000;align-items:center;justify-content:center;padding:20px}
.modal-overlay.active{display:flex!important}
.modal{background:var(--white);max-width:860px;width:100%;display:grid;grid-template-columns:1fr 1fr;position:relative;max-height:90vh;overflow-y:auto;border-radius:2px}
.modal-close{position:absolute;top:12px;right:12px;background:none;border:none;font-size:20px;cursor:pointer;color:var(--dark);z-index:10;width:32px;height:32px;display:flex;align-items:center;justify-content:center}
.modal-img-area{background:var(--light);position:relative;overflow:hidden;min-height:340px}
.mslider{position:absolute;inset:0}
.mslide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;opacity:0;transition:opacity .45s}
.mslide.active{opacity:1}
.mslide-dots{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:7px;z-index:5}
.msdot{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,0.5);cursor:pointer;border:1px solid rgba(255,255,255,0.6);transition:background .3s;touch-action:manipulation}
.msdot.active{background:var(--white)}
.mslide-prev,.mslide-next{position:absolute;top:50%;transform:translateY(-50%);z-index:5;background:rgba(255,255,255,0.88);border:none;cursor:pointer;width:34px;height:34px;display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--dark);border-radius:50%}
.mslide-prev{left:10px}.mslide-next{right:10px}
.modal-content{padding:36px 30px;display:flex;flex-direction:column;justify-content:center}
.modal-eyebrow{font-size:9px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:8px}
.modal-title{font-family:var(--fd);font-size:28px;font-weight:400;color:var(--dark);margin-bottom:6px}
.modal-price{font-family:var(--fd);font-size:22px;font-weight:600;color:var(--dark);margin-bottom:16px}
.modal-desc{font-size:12px;font-weight:300;color:var(--gray);line-height:1.9;margin-bottom:22px}
.sizes-label{font-size:10px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--dark);margin-bottom:8px}
.sizes-grid{display:flex;gap:6px;margin-bottom:20px;flex-wrap:wrap}
.size-btn{min-width:52px;height:52px;border:1.5px solid rgba(0,0,0,0.18);background:none;color:var(--dark);font-family:var(--fb);font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;border-radius:4px;letter-spacing:1px}
.size-btn:hover,.size-btn.active{background:var(--dark);color:var(--white);border-color:var(--dark)}
.payment-methods{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
.payment-chip{border:1px solid var(--gray-light);padding:6px 10px;font-size:10px;font-weight:500;border-radius:4px}
.btn-buy{background:var(--dark);color:var(--white);border:none;padding:18px;font-family:var(--fb);font-size:11px;font-weight:600;letter-spacing:3px;text-transform:uppercase;cursor:pointer;transition:background .3s;width:100%;margin-bottom:10px;border-radius:3px}
.btn-buy:hover{background:var(--gold)}
.btn-apple{background:#000;color:var(--white);border:none;padding:17px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:15px;font-weight:500;cursor:pointer;width:100%;display:flex;align-items:center;justify-content:center;gap:6px;border-radius:8px}
.btn-apple:hover{background:#222}

/* UPSELL */
.modal-upsell{padding:24px 30px 32px;border-top:1px solid rgba(0,0,0,0.07);background:var(--cream);grid-column:1/-1}
.modal-upsell-title{font-family:var(--fd);font-size:18px;font-weight:300;color:var(--dark);letter-spacing:1px;margin-bottom:18px;text-align:center}
.modal-upsell-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.modal-upsell-card{cursor:pointer;transition:transform 0.35s cubic-bezier(0.22,1,0.36,1)}
.modal-upsell-card:hover{transform:translateY(-4px)}
.modal-upsell-img-wrap{overflow:hidden;aspect-ratio:2/3;background:var(--light);margin-bottom:8px}
.modal-upsell-img-wrap img{width:100%;height:100%;object-fit:cover;object-position:center top;transition:transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94)}
.modal-upsell-card:hover .modal-upsell-img-wrap img{transform:scale(1.06)}
.modal-upsell-name{font-family:var(--fd);font-size:13px;font-weight:400;color:var(--dark);margin-bottom:3px;text-align:center}
.modal-upsell-price{font-family:var(--fb);font-size:10px;font-weight:400;color:var(--gray);letter-spacing:1px;text-align:center}
.modal-upsell-btn{display:block;width:100%;margin-top:8px;padding:7px 0;font-family:var(--fb);font-size:9px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--dark);background:transparent;border:1px solid rgba(0,0,0,0.18);cursor:pointer;transition:background .3s,color .3s;text-align:center}
.modal-upsell-btn:hover{background:var(--dark);color:var(--white);border-color:var(--dark)}

/* ABOUT */
.about-outer{background:var(--light)}
#about{padding:90px 50px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;max-width:1160px;margin:0 auto}
.about-title{font-family:var(--fd);font-size:clamp(30px,5vw,46px);font-weight:300;color:var(--dark);line-height:1.15;margin-bottom:24px}
.about-title em{font-style:italic;color:var(--gold)}
.about-text{font-size:13px;font-weight:300;color:var(--gray);line-height:2;margin-bottom:14px}
.about-sig{font-family:var(--fd);font-size:24px;font-style:italic;color:var(--gold);margin-top:28px}
.about-card{background:var(--white);padding:30px;box-shadow:0 14px 44px rgba(0,0,0,0.06)}
.about-stats{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.stat-num{font-family:var(--fd);font-size:46px;font-weight:300;color:var(--dark);line-height:1;margin-bottom:4px}
.stat-lbl{font-size:9px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold)}

/* FOOTER */
footer{background:var(--dark);padding:64px 50px 32px;color:var(--white)}
.footer-top{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1fr;gap:36px;margin-bottom:44px}
.footer-logo-wrap{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.footer-brand-col{line-height:1.4}
.fl-lemon{font-family:var(--fb);font-size:14px;font-weight:400;letter-spacing:5px;color:rgba(255,255,255,0.8);text-transform:lowercase;display:block}
.fl-paris{font-family:var(--fb);font-size:10px;font-weight:300;letter-spacing:6px;color:rgba(255,255,255,0.5);text-transform:lowercase;display:block}
.footer-desc{font-size:12px;font-weight:300;color:rgba(255,255,255,0.4);line-height:1.8;max-width:260px}
.footer-h{font-size:9px;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:14px}
.footer-links{list-style:none;display:flex;flex-direction:column;gap:8px}
.footer-links a{font-size:12px;font-weight:300;color:rgba(255,255,255,0.5);text-decoration:none;transition:color .3s, transform .3s;display:inline-block}
.footer-links a:hover{color:var(--gold);transform:translateX(4px)}
.footer-bottom{border-top:1px solid rgba(255,255,255,0.1);padding-top:22px;display:flex;align-items:center;justify-content:space-between}
.footer-copy{font-size:11px;font-weight:300;color:rgba(255,255,255,0.3)}
.footer-ig a{font-size:11px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.4);text-decoration:none;transition:color .3s}
.footer-ig a:hover{color:var(--gold)}

@media(max-width:768px){
  .hero-header{padding:20px 20px}.hero-main-title{letter-spacing:clamp(5px,3vw,14px)}.hero-main-subtitle-word{letter-spacing:clamp(6px,4vw,18px)}
  #hero{height:80vh;min-height:500px}
  
  .site-header{padding:12px 16px}.shf-nav{display:none}
  #reassurance{padding:40px 24px}.reassurance-inner{flex-direction:column;gap:32px}.reassurance-item+.reassurance-item::before{width:40px;height:1px;top:-16px;left:50%;transform:translateX(-50%)}.reassurance-item{padding:0}
  .products-grid{grid-template-columns:repeat(2,1fr);gap:10px}#collection{padding:64px 10px}
  .product-card{touch-action:manipulation}.product-img-wrap{min-height:240px}
  #about{grid-template-columns:1fr;padding:64px 16px;gap:40px}
  .footer-top{grid-template-columns:1fr 1fr;gap:28px}footer{padding:48px 16px 26px}
  #newsletter{padding:64px 16px}
  .modal{grid-template-columns:45% 55%;border-radius:0;height:100vh;max-height:100vh;overflow:hidden}.modal-overlay{padding:0;align-items:flex-start}
  .modal-img-area{height:100vh;aspect-ratio:unset;min-height:unset;background:var(--light)}
  .modal-img-area .mslide{object-fit:contain;object-position:center top}
  .modal-content{height:100vh;max-height:100vh;overflow-y:auto;padding:40px 12px 20px;justify-content:flex-start}
  .modal-upsell{display:none}
  .modal-title{font-size:17px;margin-bottom:4px}.modal-price{font-size:15px;margin-bottom:12px}.modal-eyebrow{font-size:8px}.rarity-badge{font-size:8px;margin-bottom:6px}
  .modal-desc-text{font-size:12px;line-height:1.65}.modal-desc-label{font-size:8px;margin-bottom:7px}.modal-description{margin-bottom:14px;padding-bottom:14px}
  .modal-features{gap:4px;margin-bottom:12px;padding-bottom:12px}.modal-feature{font-size:10px;gap:6px}.modal-feature-icon{width:13px;height:13px;font-size:8px}
  .sizes-label{font-size:9px;margin-bottom:6px}.sizes-grid{gap:4px;margin-bottom:14px}.size-btn{min-width:34px;height:36px;font-size:11px;padding:0 6px}
  .payment-methods{display:none}.btn-buy{padding:12px 6px;font-size:9px;letter-spacing:2px;margin-bottom:8px}.btn-apple{padding:11px 6px;font-size:13px}
}

/* ══ PRODUCT BADGES FEATURES ══ */
.modal-features {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.modal-feature {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--fb);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 1px;
  color: var(--dark);
}
.modal-feature-icon {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--dark);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 9px;
  font-weight: 600;
  flex-shrink: 0;
}

/* ══ PRODUCT DESCRIPTION BLOCK ══ */
.modal-description {
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.modal-desc-label {
  font-family: var(--fb);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--dark);
  margin-bottom: 10px;
}
.modal-desc-text {
  font-family: var(--fd);
  font-size: 15px;
  font-weight: 400;
  font-style: normal;
  color: #333;
  line-height: 1.85;
}
.modal-tab-bar {
  display: flex;
  border-bottom: 1.5px solid rgba(0,0,0,0.08);
  margin-bottom: 18px;
  gap: 0;
}
.modal-tab-btn {
  flex: 1;
  background: none;
  border: none;
  border-bottom: 2.5px solid transparent;
  margin-bottom: -1.5px;
  padding: 10px 8px;
  font-family: var(--fb);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--gray);
  cursor: pointer;
  transition: color .2s, border-color .2s;
}
.modal-tab-btn.active {
  color: var(--dark);
  border-bottom-color: var(--dark);
}
.modal-pane { display: none; }
.modal-pane.active { display: block; }

/* ══ PHOTO TRANSITION SMOOTH ══ */
.mslide {
  transition: opacity 0.55s cubic-bezier(0.22,1,0.36,1) !important;
}

/* ══ HOVER ZOOM on modal image ══ */
.modal-img-area {
  overflow: hidden;
}
.modal-img-area .mslide {
  transform-origin: center center;
  transition: opacity 0.55s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.25,0.46,0.45,0.94) !important;
}
.modal-img-area:hover .mslide.active {
  transform: scale(1.04);
}


/* ══ REVIEWS SECTION ══ */
#reviews {
  padding: 0 0 100px;
  background: var(--cream);
  overflow: hidden;
}

/* Hero header with background photo */
.reviews-header {
  position: relative;
  text-align: center;
  padding: 130px 50px 100px;
  margin-bottom: 72px;
  overflow: hidden;
}
.reviews-header-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  transform: scale(1.05);
  transition: transform 0.1s linear;
  will-change: transform;
}
.reviews-header-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(250,250,248,0.92) 0%,
    rgba(250,250,248,0.88) 50%,
    rgba(250,250,248,0.96) 100%
  );
}
.reviews-header-content {
  position: relative;
  z-index: 2;
}
.reviews-eyebrow {
  font-family: var(--fb);
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 7px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 18px;
}
.reviews-title {
  font-family: var(--fd);
  font-size: clamp(36px, 5.5vw, 64px);
  font-weight: 200;
  color: var(--dark);
  line-height: 1.05;
  margin-bottom: 18px;
}
.reviews-subtitle {
  font-family: var(--fd);
  font-size: clamp(14px, 1.8vw, 19px);
  font-weight: 300;
  font-style: italic;
  color: #555;
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.7;
}

/* Cards grid */
.reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  max-width: 1100px;
  margin: 0 auto 20px;
}
.reviews-grid-bottom {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  max-width: 740px;
  margin: 0 auto;
}

/* Card */
.review-card {
  background: var(--white);
  border-radius: 6px;
  padding: 36px 32px;
  border: 1px solid rgba(0,0,0,0.06);
  box-shadow: 0 4px 24px rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), box-shadow 0.4s ease;
}
.review-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.09);
}
.review-stars {
  color: var(--gold);
  font-size: 14px;
  letter-spacing: 3px;
}
.review-text {
  font-family: var(--fd);
  font-size: 16px;
  font-weight: 300;
  font-style: italic;
  color: var(--dark);
  line-height: 1.75;
  flex: 1;
}
.review-author {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 14px;
  border-top: 1px solid rgba(0,0,0,0.06);
}
.review-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--fb);
  font-size: 12px;
  font-weight: 500;
  color: var(--white);
  flex-shrink: 0;
  letter-spacing: 0;
}
.review-name {
  font-family: var(--fb);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 2px;
  color: var(--dark);
  text-transform: uppercase;
}
.review-label {
  font-family: var(--fb);
  font-size: 9px;
  font-weight: 300;
  letter-spacing: 2px;
  color: var(--gray);
  margin-top: 2px;
}

/* Global rating strip */
.reviews-rating-strip {
  text-align: center;
  margin-top: 60px;
}
.reviews-rating-number {
  font-family: var(--fd);
  font-size: 52px;
  font-weight: 200;
  color: var(--dark);
  line-height: 1;
}
.reviews-rating-stars {
  color: var(--gold);
  font-size: 18px;
  letter-spacing: 4px;
  margin: 8px 0;
}
.reviews-rating-label {
  font-family: var(--fb);
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--gray);
}

@media (max-width: 900px) {
  #reviews { padding: 0 0 72px; }
  .reviews-header { padding: 90px 20px 72px; margin-bottom: 40px; }
  .reviews-grid { grid-template-columns: 1fr; padding: 0 16px; }
  .reviews-grid-bottom { grid-template-columns: 1fr; max-width: 100%; padding: 0 16px; }
  .review-card { padding: 28px 24px; }
}


/* ══ RARITY BADGE ══ */
.rarity-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: var(--fb);
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 12px;
}
.rarity-badge::before {
  content: '';
  display: block;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--gold);
  opacity: 0.8;
}


/* ══ CART DRAWER ══ */
.cart-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 400;
  backdrop-filter: blur(3px);
  opacity: 0;
  transition: opacity 0.35s ease;
}
.cart-overlay.open { display: block; }
.cart-overlay.visible { opacity: 1; }

.cart-drawer {
  position: fixed;
  top: 0; right: 0; bottom: 0;
  width: 420px;
  max-width: 100vw;
  background: var(--white);
  z-index: 401;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.45s cubic-bezier(0.22,1,0.36,1);
  box-shadow: -8px 0 40px rgba(0,0,0,0.12);
}
.cart-drawer.open { transform: translateX(0); }

.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28px 28px 20px;
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.cart-title {
  font-family: var(--fd);
  font-size: 22px;
  font-weight: 300;
  color: var(--dark);
  letter-spacing: 0.5px;
}
.cart-close {
  width: 48px; height: 48px;
  background: var(--light); border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  color: var(--dark); font-size: 22px; font-weight: 700;
  border-radius: 50%;
  transition: background 0.2s;
  flex-shrink: 0;
}
.cart-close:hover { background: #e0e0e0; }

.cart-body { flex: 1; overflow-y: auto; padding: 24px 28px; }

/* Added product card */
.cart-item {
  display: flex;
  gap: 16px;
  margin-bottom: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(0,0,0,0.06);
  animation: cartItemIn 0.4s cubic-bezier(0.22,1,0.36,1) forwards;
}
@keyframes cartItemIn {
  from { opacity:0; transform:translateY(12px); }
  to   { opacity:1; transform:translateY(0); }
}
.cart-item-img {
  width: 90px; height: 112px;
  object-fit: cover; object-position: center top;
  border-radius: 4px;
  flex-shrink: 0;
}
.cart-item-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.cart-item-collection {
  font-family: var(--fb); font-size: 8px; font-weight: 500;
  letter-spacing: 3px; text-transform: uppercase; color: var(--gold);
  margin-bottom: 4px;
}
.cart-item-name {
  font-family: var(--fd); font-size: 15px; font-weight: 500; color: var(--dark);
  margin-bottom: 3px; line-height: 1.3;
}
.cart-item-size {
  font-family: var(--fb); font-size: 9px; font-weight: 600;
  letter-spacing: 3px; color: var(--gray); margin-bottom: 6px;
  text-transform: uppercase;
}
.cart-item-price {
  font-family: var(--fd); font-size: 19px; font-weight: 700; color: var(--gold);
  letter-spacing: 0.5px; margin-top: 4px;
}
.cart-added-badge {
  display: inline-flex; align-items: center; gap: 5px;
  font-family: var(--fb); font-size: 9px; font-weight: 500;
  letter-spacing: 2px; text-transform: uppercase; color: #2d7a4f;
  margin-bottom: 12px;
}
.cart-added-badge::before {
  content: ''; display: block; width: 6px; height: 6px;
  border-radius: 50%; background: #2d7a4f;
}

/* Upsell in cart */
.cart-upsell { margin-top: 8px; }
.cart-upsell-title {
  font-family: var(--fb); font-size: 9px; font-weight: 500;
  letter-spacing: 4px; text-transform: uppercase; color: var(--dark);
  margin-bottom: 14px;
}
.cart-upsell-grid {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 10px;
}
.cart-upsell-card {
  cursor: pointer;
  transition: transform 0.3s cubic-bezier(0.22,1,0.36,1);
}
.cart-upsell-card:hover { transform: translateY(-3px); }
.cart-upsell-img {
  width: 100%; aspect-ratio: 3/4;
  object-fit: cover; object-position: center top;
  border-radius: 2px; margin-bottom: 6px;
  transition: transform 0.4s ease;
}
.cart-upsell-card:hover .cart-upsell-img { transform: scale(1.04); overflow: hidden; }
.cart-upsell-name {
  font-family: var(--fd); font-size: 12px; font-weight: 400;
  color: var(--dark); text-align: center; margin-bottom: 2px;
}
.cart-upsell-price {
  font-family: var(--fb); font-size: 10px; font-weight: 300;
  color: var(--gray); text-align: center;
}

/* Cart footer */
.cart-footer {
  padding: 20px 28px 28px;
  border-top: 1px solid rgba(0,0,0,0.07);
}
.cart-total {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 18px;
}
.cart-total-label {
  font-family: var(--fb); font-size: 10px; font-weight: 500;
  letter-spacing: 3px; text-transform: uppercase; color: var(--dark);
}
.cart-total-price {
  font-family: var(--fd); font-size: 24px; font-weight: 600; color: var(--dark);
}
.cart-btn-continue {
  display: block; width: 100%; padding: 14px;
  text-align: center; font-family: var(--fb);
  font-size: 10px; font-weight: 500; letter-spacing: 3px; text-transform: uppercase;
  color: var(--dark); background: transparent;
  border: 1px solid rgba(0,0,0,0.15); cursor: pointer;
  transition: all 0.3s; margin-bottom: 10px;
}
.cart-btn-continue:hover { border-color: var(--dark); background: var(--dark); color: var(--white); }

.cart-btn-checkout {
  display: block; width: 100%; padding: 16px;
  text-align: center; font-family: var(--fb);
  font-size: 10px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase;
  color: var(--white); background: var(--dark);
  border: none; cursor: pointer;
  transition: background 0.3s; margin-bottom: 10px;
}
.cart-btn-checkout:hover { background: #333; }

/* Apple Pay button */
.cart-btn-applepay {
  display: flex; align-items: center; justify-content: center;
  width: 100%; padding: 15px;
  background: var(--dark); color: var(--white);
  border: none; border-radius: 8px; cursor: pointer;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 15px; font-weight: 500; letter-spacing: 0;
  transition: background 0.3s; gap: 6px;
}
.cart-btn-applepay:hover { background: #1a1a1a; }
.cart-btn-applepay svg { width: 32px; height: 20px; }

/* ══ SIZE BUTTON IMPROVEMENTS ══ */
.size-btn {
  position: relative;
  overflow: hidden;
}
.size-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--dark);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s cubic-bezier(0.22,1,0.36,1);
  z-index: 0;
}
.size-btn span { position: relative; z-index: 1; }
.size-btn:hover::after { transform: scaleX(1); }
.size-btn:hover { color: var(--white); border-color: var(--dark); }
.size-btn.active::after { transform: scaleX(1); }
.size-btn.active { color: var(--white); }

/* ══ ADD TO CART BUTTON ══ */
.btn-buy {
  position: relative;
  overflow: hidden;
  transform: translateY(0);
  transition: background 0.3s, transform 0.2s, box-shadow 0.3s !important;
}
.btn-buy:hover {
  background: var(--gold) !important;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.15);
}
.btn-buy:active { transform: translateY(0); }
.btn-buy.success {
  background: #2d7a4f !important;
  transform: translateY(-2px);
}

/* ══ APPLE PAY MODAL BUTTON ══ */
.btn-apple {
  background: #000 !important;
  border-radius: 8px !important;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif !important;
  font-size: 15px !important;
  font-weight: 500 !important;
  letter-spacing: 0 !important;
  padding: 15px !important;
}

@media (max-width: 768px) {
  .cart-drawer { width: 100%; }
  .cart-upsell-grid { grid-template-columns: repeat(3,1fr); }
}


@keyframes sizeshake {
  0%,100% { transform: translateX(0); }
  25% { transform: translateX(-4px); }
  75% { transform: translateX(4px); }
}


/* ══ CART ITEM CONTROLS ══ */
.cart-item-qty {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
}
.cart-qty-btn {
  width: 34px; height: 34px;
  border: 1.5px solid rgba(0,0,0,0.18);
  background: none; cursor: pointer;
  font-size: 16px; font-weight: 300;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s; border-radius: 3px;
  color: var(--dark);
}
.cart-qty-btn:hover { background: var(--dark); color: var(--white); border-color: var(--dark); }
.cart-qty-num {
  font-family: var(--fb); font-size: 12px; font-weight: 500;
  color: var(--dark); min-width: 16px; text-align: center;
}
.cart-item-remove {
  font-family: var(--fb); font-size: 9px; font-weight: 400;
  letter-spacing: 2px; text-transform: uppercase;
  color: var(--gray); background: none; border: none;
  cursor: pointer; padding: 0; margin-top: 6px;
  transition: color 0.2s; display: block;
  text-decoration: underline; text-underline-offset: 3px;
}
.cart-item-remove:hover { color: var(--dark); }
.cart-empty {
  text-align: center; padding: 60px 20px;
}
.cart-empty-title {
  font-family: var(--fd); font-size: 24px; font-weight: 300;
  color: var(--dark); margin-bottom: 10px;
}
.cart-empty-sub {
  font-family: var(--fb); font-size: 11px; font-weight: 300;
  letter-spacing: 2px; color: var(--gray);
}
.cart-count-badge {
  position: absolute; top: -6px; right: -6px;
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--dark); color: var(--white);
  font-family: var(--fb); font-size: 9px; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  display: none;
}


/* ══ CART ICON ══ */
.cart-icon-btn {
  position: relative;
  background: none; border: none; cursor: pointer;
  width: 40px; height: 40px;
  display: flex; align-items: center; justify-content: center;
  color: var(--dark); transition: color 0.3s;
  margin-left: 8px;
}
.cart-icon-btn:hover { color: var(--gold); }
.cart-count {
  position: absolute; top: 2px; right: 2px;
  width: 16px; height: 16px; border-radius: 50%;
  background: var(--dark); color: var(--white);
  font-family: var(--fb); font-size: 9px; font-weight: 600;
  display: flex !important; align-items: center; justify-content: center;
  line-height: 1;
}

/* ══ CHECKOUT PAGE ══ */
.checkout-overlay {
  display: none; position: fixed; inset: 0;
  background: var(--cream); z-index: 500;
  overflow-y: auto;
}
.checkout-overlay.open { display: block; }

.checkout-page {
  max-width: 560px; margin: 0 auto;
  padding: 40px 24px 80px;
  min-height: 100vh;
}
.checkout-logo {
  text-align: center; margin-bottom: 36px;
}
.checkout-logo img { height: 48px; width: auto; }

/* Progress bar */
.checkout-progress {
  display: flex; align-items: center;
  margin-bottom: 44px; padding: 0 8px;
}
.cp-step {
  display: flex; flex-direction: column; align-items: center;
  flex: 1; position: relative;
}
.cp-step-dot {
  width: 12px; height: 12px; border-radius: 50%;
  border: 2px solid var(--gray-light);
  background: var(--white); z-index: 1;
  transition: all 0.3s;
}
.cp-step.active .cp-step-dot { background: var(--dark); border-color: var(--dark); }
.cp-step.done .cp-step-dot { background: var(--dark); border-color: var(--dark); }
.cp-step-label {
  font-family: var(--fb); font-size: 8px; font-weight: 500;
  letter-spacing: 2px; text-transform: uppercase;
  color: var(--gray); margin-top: 6px; text-align: center;
}
.cp-step.active .cp-step-label { color: var(--dark); }
.cp-step-line {
  position: absolute; top: 5px; left: calc(50% + 8px);
  right: calc(-50% + 8px); height: 1px;
  background: var(--gray-light);
}
.cp-step.done .cp-step-line { background: var(--dark); }

/* Checkout content */
.checkout-title {
  font-family: var(--fd); font-size: 28px; font-weight: 300;
  color: var(--dark); margin-bottom: 6px;
}
.checkout-subtitle {
  font-family: var(--fb); font-size: 11px; font-weight: 300;
  letter-spacing: 1px; color: var(--gray); margin-bottom: 32px;
}

/* Cart summary */
.co-item {
  display: flex; gap: 16px;
  padding: 20px 0; border-bottom: 1px solid rgba(0,0,0,0.06);
}
.co-item-img {
  width: 72px; height: 90px; object-fit: cover;
  object-position: center top; border-radius: 2px; flex-shrink: 0;
}
.co-item-info { flex: 1; }
.co-item-name { font-family: var(--fd); font-size: 17px; font-weight: 400; color: var(--dark); margin-bottom: 4px; }
.co-item-meta { font-family: var(--fb); font-size: 10px; font-weight: 300; letter-spacing: 1px; color: var(--gray); margin-bottom: 10px; }
.co-item-row { display: flex; align-items: center; justify-content: space-between; }
.co-item-price { font-family: var(--fd); font-size: 18px; font-weight: 600; color: var(--dark); }
.co-qty { display: flex; align-items: center; gap: 10px; }
.co-qty-btn {
  width: 28px; height: 28px; border: 1px solid rgba(0,0,0,0.15);
  background: none; cursor: pointer; font-size: 16px;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s; border-radius: 2px; color: var(--dark);
}
.co-qty-btn:hover { background: var(--dark); color: var(--white); }
.co-qty-num { font-family: var(--fb); font-size: 13px; font-weight: 500; min-width: 20px; text-align: center; }
.co-remove {
  font-family: var(--fb); font-size: 9px; font-weight: 400;
  letter-spacing: 2px; text-transform: uppercase;
  color: var(--gray); background: none; border: none; cursor: pointer;
  text-decoration: underline; text-underline-offset: 3px;
  transition: color 0.2s; padding: 0; margin-top: 8px; display: block;
}
.co-remove:hover { color: var(--dark); }

/* Totals */
.co-totals { margin-top: 28px; }
.co-total-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12px 0; border-bottom: 1px solid rgba(0,0,0,0.06);
}
.co-total-label { font-family: var(--fb); font-size: 11px; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; color: var(--gray); }
.co-total-val { font-family: var(--fd); font-size: 18px; font-weight: 400; color: var(--dark); }
.co-total-row.grand { border-bottom: none; margin-top: 4px; }
.co-total-row.grand .co-total-label { color: var(--dark); font-weight: 600; font-size: 12px; }
.co-total-row.grand .co-total-val { font-size: 26px; font-weight: 600; }

/* Checkout buttons */
.co-btn-primary {
  display: flex; align-items: center; justify-content: center;
  width: 100%; padding: 18px;
  background: var(--dark); color: var(--white);
  border: none; cursor: pointer; margin-top: 20px;
  font-family: var(--fb); font-size: 11px; font-weight: 600;
  letter-spacing: 4px; text-transform: uppercase;
  transition: background 0.3s, transform 0.2s;
}
.co-btn-primary:hover { background: #333; transform: translateY(-2px); }

.co-btn-apple {
  display: flex; align-items: center; justify-content: center;
  width: 100%; padding: 17px; gap: 8px;
  background: #000; color: #fff;
  border: none; cursor: pointer; margin-top: 10px;
  border-radius: 8px;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 16px; font-weight: 500;
  transition: background 0.3s;
}
.co-btn-apple:hover { background: #1a1a1a; }
.co-btn-apple svg { width: 36px; height: 22px; }

.co-btn-back {
  display: block; text-align: center; margin-top: 20px;
  font-family: var(--fb); font-size: 10px; font-weight: 500;
  letter-spacing: 3px; text-transform: uppercase;
  color: var(--dark); background: none; border: 1px solid rgba(0,0,0,0.15);
  padding: 12px 0; cursor: pointer; transition: all 0.2s; width: 100%;
}
.co-btn-back:hover { background: var(--light); border-color: var(--dark); }

/* Form */
.co-form { margin-top: 8px; }
.co-form-section { margin-bottom: 32px; }
.co-form-title {
  font-family: var(--fb); font-size: 10px; font-weight: 600;
  letter-spacing: 4px; text-transform: uppercase;
  color: var(--dark); margin-bottom: 20px;
  padding-bottom: 10px; border-bottom: 1px solid rgba(0,0,0,0.08);
}
.co-field { margin-bottom: 18px; position: relative; }
.co-field label {
  display: block; font-family: var(--fb); font-size: 10px;
  font-weight: 400; letter-spacing: 2px; text-transform: uppercase;
  color: var(--gray); margin-bottom: 8px;
}
.co-field input, .co-field select {
  width: 100%; padding: 14px 0;
  border: none; border-bottom: 1px solid rgba(0,0,0,0.15);
  background: transparent; outline: none;
  font-family: var(--fb); font-size: 14px; font-weight: 300;
  color: var(--dark); transition: border-color 0.3s;
  -webkit-appearance: none; border-radius: 0;
}
.co-field input:focus, .co-field select:focus { border-bottom-color: var(--dark); }
.co-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

/* Confirmation */
.co-confirm {
  text-align: center; padding: 40px 0;
}
.co-confirm-icon {
  width: 64px; height: 64px; border-radius: 50%;
  background: #f0f9f4; border: 2px solid #2d7a4f;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 24px; font-size: 28px; color: #2d7a4f;
}
.co-confirm-title { font-family: var(--fd); font-size: 32px; font-weight: 300; color: var(--dark); margin-bottom: 12px; }
.co-confirm-sub { font-family: var(--fb); font-size: 12px; font-weight: 300; letter-spacing: 1px; color: var(--gray); line-height: 1.8; }
.co-confirm-order { font-family: var(--fb); font-size: 10px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); margin: 20px 0 8px; }


/* ══ CATEGORY FILTER TABS ══ */
.cat-tabs{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:52px;border-bottom:1px solid rgba(0,0,0,0.08)}
.cat-tab{font-family:var(--fb);font-size:9px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gray);background:none;border:none;cursor:pointer;padding:14px 28px;position:relative;transition:color .3s}
.cat-tab::after{content:'';position:absolute;bottom:-1px;left:0;width:100%;height:1.5px;background:var(--dark);transform:scaleX(0);transition:transform .35s cubic-bezier(0.22,1,0.36,1)}
.cat-tab:hover{color:var(--dark)}
.cat-tab.active{color:var(--dark)}
.cat-tab.active::after{transform:scaleX(1)}
.product-card.hidden{display:none!important}
/* ══ NAV DROPDOWN ══ */
.nav-dropdown{position:relative;display:flex;align-items:center}
.nav-dropdown>a{display:flex;align-items:center;gap:5px}
.nav-arrow{display:inline-block;width:0;height:0;border-left:3px solid transparent;border-right:3px solid transparent;border-top:4px solid currentColor;transition:transform .25s;margin-top:1px}
.nav-dropdown:hover .nav-arrow{transform:rotate(180deg)}
.nav-sub{position:absolute;top:calc(100% + 16px);left:50%;transform:translateX(-50%) translateY(-6px);background:rgba(255,255,255,0.98);backdrop-filter:blur(20px);border:1px solid rgba(0,0,0,0.06);box-shadow:0 12px 40px rgba(0,0,0,0.08);padding:8px 0;min-width:185px;opacity:0;visibility:hidden;transition:opacity .25s,transform .25s,visibility .25s}
.nav-dropdown:hover .nav-sub{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0)}
.nav-sub a{display:block;font-family:var(--fb);font-size:9px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--dark)!important;padding:10px 22px;transition:color .2s,background .2s;text-decoration:none}
.nav-sub a:hover{color:var(--gold)!important;background:rgba(201,170,106,0.05)}
/* ══ MOBILE SUB ══ */
.mobile-sub{display:flex;flex-direction:column;gap:18px;align-items:center;padding:14px 0 6px;border-top:1px solid rgba(255,255,255,0.08)}
.mobile-sub a{font-family:var(--fb)!important;font-size:9px!important;letter-spacing:5px!important;text-transform:uppercase;color:rgba(255,255,255,0.5)!important;text-decoration:none;transition:color .3s}
.mobile-sub a:hover{color:var(--gold)!important}
@media(max-width:768px){.cat-tabs{flex-wrap:wrap}.cat-tab{padding:11px 12px;font-size:8px;letter-spacing:2.5px}}


/* ══ CAP PRODUCT SLIDES — full cap visible ══ */
