        <script>
const slideState={};
function slideTo(id,idx){
  const sl=document.getElementById('slider-'+id);
  const slides=sl.querySelectorAll('.slide');
  const total=slides.length;
  idx=((idx%total)+total)%total;
  slideState[id]=idx;
  slides.forEach((s,i)=>s.classList.toggle('active',i===idx));
  sl.closest('.product-img-wrap').querySelectorAll('.sdot').forEach((d,i)=>d.classList.toggle('active',i===idx));
}
function slideNext(id){slideTo(id,(slideState[id]||0)+1)}
function slidePrev(id){slideTo(id,(slideState[id]||0)-1)}
function mSlideTo(id,idx){
  const ms=document.getElementById('mslider-'+id);
  const slides=ms.querySelectorAll('.mslide');
  const total=slides.length;
  idx=((idx%total)+total)%total;
  slides.forEach((s,i)=>s.classList.toggle('active',i===idx));
  ms.closest('.modal-img-area').querySelectorAll('.msdot').forEach((d,i)=>d.classList.toggle('active',i===idx));
}
function mSlideNext(id){const ms=document.getElementById('mslider-'+id);let c=0;ms.querySelectorAll('.mslide').forEach((s,i)=>{if(s.classList.contains('active'))c=i});mSlideTo(id,c+1)}
function mSlidePrev(id){const ms=document.getElementById('mslider-'+id);let c=0;ms.querySelectorAll('.mslide').forEach((s,i)=>{if(s.classList.contains('active'))c=i});mSlideTo(id,c-1)}


function fillUpsellImages(modalEl) {
  if (!modalEl) return;
  modalEl.querySelectorAll('img[data-pid]').forEach(function(img) {
    var src = getSlide(img.dataset.pid);
    if (src) img.src = src;
  });
}

function openModal(id){var ov=document.getElementById('modal-'+id);ov.classList.add('active');ov.style.display='flex';var sy=window.scrollY||window.pageYOffset;document.body.dataset.scrolly=sy;document.body.style.top='-'+sy+'px';document.body.style.position='fixed';document.body.style.width='100%';document.body.style.overflow='hidden';document.documentElement.style.overflow='hidden';mSlideTo(id,0);fillUpsellImages(document.getElementById('modal-'+id));}
function closeModal(id){var ov=document.getElementById('modal-'+id);ov.classList.remove('active');ov.style.display='none';var sy=parseInt(document.body.dataset.scrolly||'0');document.body.style.position='';document.body.style.top='';document.body.style.width='';document.body.style.overflow='';document.documentElement.style.overflow='';window.scrollTo(0,sy);}
function closeModalOutside(e,id){if(e.target===e.currentTarget)closeModal(id)}
function switchModal(newId){['e1','e2','e3','e4','e5','ts_rose','ts_bleu','sh_rose','sh_bleu','cap_bleu','cap_rose'].forEach(id=>{ const el=document.getElementById('modal-'+id); if(el) el.classList.remove('active');});document.getElementById('modal-'+newId).classList.add('active');mSlideTo(newId,0);fillUpsellImages(document.getElementById('modal-'+newId));}
document.addEventListener('keydown',e=>{if(e.key==='Escape')['e1','e2','e3','e4','e5','ts_rose','ts_bleu','sh_rose','sh_bleu','cap_bleu','cap_rose'].forEach(id=>closeModal(id))});


function filterCat(cat) {
  // update tabs
  document.querySelectorAll('.cat-tab').forEach(t => {
    const tc = t.getAttribute('onclick').match(/filterCat\('(.*?)'\)/)[1];
    t.classList.toggle('active', tc === cat);
  });
  // filter cards
  document.querySelectorAll('.product-card[data-category]').forEach(card => {
    if (cat === 'all' || card.dataset.category === cat) {
      card.classList.remove('hidden');
    } else {
      card.classList.add('hidden');
    }
  });
  // smooth scroll to collection
  const col = document.getElementById('collection');
  if (col) col.scrollIntoView({behavior: 'smooth', block: 'start'});
}

function selectSize(btn){btn.closest('.sizes-grid').querySelectorAll('.size-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active')}


function handleNL(e){e.preventDefault();document.getElementById('nl-ok').style.display='block';e.target.style.display='none'}

/* Touch swipe */
document.querySelectorAll('.product-img-wrap').forEach(wrap=>{
  let sx=0;
  wrap.addEventListener('touchstart',e=>{sx=e.touches[0].clientX},{passive:true});
  wrap.addEventListener('touchend',e=>{
    const diff=sx-e.changedTouches[0].clientX;
    const sl=wrap.querySelector('.slider');if(!sl)return;
    const id=sl.id.replace('slider-','');
    if(Math.abs(diff)>40){if(diff>0)slideNext(id);else slidePrev(id)}
  },{passive:true});
});
document.querySelectorAll('.modal-img-area').forEach(area=>{
  let sx=0;
  area.addEventListener('touchstart',e=>{sx=e.touches[0].clientX},{passive:true});
  area.addEventListener('touchend',e=>{
    const diff=sx-e.changedTouches[0].clientX;
    const ms=area.querySelector('.mslider');if(!ms)return;
    const id=ms.id.replace('mslider-','');
    let c=0;ms.querySelectorAll('.mslide').forEach((s,i)=>{if(s.classList.contains('active'))c=i});
    if(Math.abs(diff)>40){if(diff>0)mSlideTo(id,c+1);else mSlideTo(id,c-1)}
  },{passive:true});
});

/* Mobile nav */
function openMobileNav(){document.getElementById('mobileNav').classList.add('open');document.body.style.overflow='hidden'}
function closeMobileNav(){document.getElementById('mobileNav').classList.remove('open');document.body.style.overflow=''}

/* Scroll */
window.addEventListener('scroll',()=>{
  const scrollY=window.scrollY;
  const bg=document.querySelector('.hero-bg-img');
  if(bg&&scrollY<window.innerHeight)bg.style.transform='scale(1.0) translateY('+(scrollY*0.22)+'px)';
  document.getElementById('siteHeader').classList.toggle('visible',scrollY>window.innerHeight*0.6);
});

/* Reveal observer */
const io=new IntersectionObserver((entries)=>{
  entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');io.unobserve(entry.target);}});
},{threshold:0.07,rootMargin:'0px 0px -30px 0px'});
document.querySelectorAll('.reveal,.product-card').forEach(el=>io.observe(el));

/* Smooth scroll */
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{const t=document.querySelector(a.getAttribute('href'));if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'});}});
});

/* ══ REVIEWS HEADER PARALLAX ══ */
(function() {
  const reviewsBg = document.querySelector('.reviews-header-bg');
  if (!reviewsBg) return;
  function onScroll() {
    const rect = reviewsBg.closest('.reviews-header').getBoundingClientRect();
    const center = rect.top + rect.height / 2 - window.innerHeight / 2;
    const shift = center * 0.12;
    reviewsBg.style.transform = 'scale(1.05) translateY(' + shift + 'px)';
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();




