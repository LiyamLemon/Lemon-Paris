};

/* ── Helpers ── */
function getSlide(pid) {
  const sl = document.getElementById('slider-'+pid);
  if (!sl) return '';
  const slide = sl.querySelector('.slide');
  return slide ? slide.src : '';
}
function fmtPrice(n) { return n.toFixed(2).replace('.',',') + ' €'; }
function cartTotal() { return cartItems.reduce((s,i)=>s+i.price*i.qty,0); }
function cartCount() { return cartItems.reduce((s,i)=>s+i.qty,0); }
function updateBadge() {
  const el = document.getElementById('cartCount');
  if (!el) return;
  const n = cartCount();
  el.textContent = n;
  el.style.display = n > 0 ? 'flex' : 'none';
}

/* ── Add to cart ── */
function addToCart(name, price) {
  const modal = document.querySelector('.modal-overlay.active');
  const sz = modal ? modal.querySelector('.size-btn.active') : null;
  if (!sz) {
    if (modal) modal.querySelectorAll('.size-btn').forEach(b=>{
      b.style.animation='none'; b.offsetHeight; b.style.animation='sizeshake 0.35s ease';
    });
    return;
  }
  let pid = null;
  ['e1','e2','e3','e4','e5','ts_rose','ts_bleu','sh_rose','sh_bleu','cap_bleu','cap_rose'].forEach(id=>{
    const mel=document.getElementById('modal-'+id); if(mel && mel.classList.contains('active')) pid=id;
  });
  if (!pid) return;
  const p = PRODUCTS[pid];
  const size = sz.textContent.replace(/<[^>]*>/g,'').trim();
  const key = pid+'_'+size;
  const img = getSlide(pid);
  const existing = cartItems.find(i=>i.key===key);
  if (existing) { existing.qty++; }
  else { cartItems.push({key,pid,name:p.name,collection:p.collection,price:p.price,priceStr:p.priceStr,size,qty:1,img}); }
  updateBadge();
  const btn = modal.querySelector('.btn-buy');
  if (btn) {
    btn.classList.add('success');
    btn.querySelector('span') ? btn.querySelector('span').textContent='✓ Ajouté' : btn.textContent='✓ Ajouté';
    setTimeout(()=>{ btn.classList.remove('success'); btn.querySelector('span') ? btn.querySelector('span').textContent='Ajouter au panier' : btn.textContent='Ajouter au panier'; },1800);
  }
  renderCartDrawer();
  openCart();
}

function buyNow(name,price){ addToCart(name,price); }

function removeFromCart(key) { cartItems=cartItems.filter(i=>i.key!==key); updateBadge(); renderCartDrawer(); }

function changeQty(key,delta) {
  const it=cartItems.find(i=>i.key===key);
  if(!it) return;
  it.qty+=delta;
  if(it.qty<=0) cartItems=cartItems.filter(i=>i.key!==key);
  updateBadge(); renderCartDrawer();
}

/* ── Cart Drawer ── */
function renderCartDrawer() {
  const body=document.getElementById('cartBody');
  const footer=document.getElementById('cartFooter');
  if(!body) return;
  if(cartItems.length===0){
    body.innerHTML='<div class="cart-empty"><p class="cart-empty-title">Votre panier est vide</p><p class="cart-empty-sub">Découvrez la collection</p></div>';
    if(footer) footer.style.display='none';
    return;
  }
  const itemsHtml=cartItems.map(it=>`
    <div class="cart-item">
      <img class="cart-item-img" src="${it.img}" alt="${it.name}"/>
      <div class="cart-item-info">
        <p class="cart-item-collection">${it.collection}</p>
        <p class="cart-item-name">${it.name}</p>
        <p class="cart-item-size">Taille : ${it.size}</p>
        <p class="cart-item-price">${it.priceStr} €</p>
        <div class="cart-item-qty">
          <button class="cart-qty-btn" onclick="changeQty('${it.key}',-1)">−</button>
          <span class="cart-qty-num">${it.qty}</span>
          <button class="cart-qty-btn" onclick="changeQty('${it.key}',1)">+</button>
        </div>
        <button class="cart-item-remove" onclick="removeFromCart('${it.key}')">Supprimer</button>
      </div>
    </div>`).join('');
  const inCart=[...new Set(cartItems.map(i=>i.pid))];
  const upPids=['e1','e2','e3','e4','ts_rose','ts_bleu','sh_rose','sh_bleu','cap_bleu','cap_rose'].filter(p=>!inCart.includes(p)).slice(0,3);
  const upsell=upPids.length?`<div class="cart-upsell"><p class="cart-upsell-title">Complétez votre look</p><div class="cart-upsell-grid">${upPids.map(pid=>{const p=PRODUCTS[pid];if(!p)return'';const img=getSlide(pid);return`<div class="cart-upsell-card" onclick="closeCart();openModal('${pid}')"><img class="cart-upsell-img" src="${img}" alt="${p.name}"/><p class="cart-upsell-name">${p.name}</p><p class="cart-upsell-price">${p.priceStr} €</p></div>`;}).join('')}</div></div>`:''
  body.innerHTML=itemsHtml+upsell;
  const tot=cartTotal();
  const el=document.getElementById('cartTotalPrice');
  if(el) el.textContent=fmtPrice(tot);
  if(footer) footer.style.display='block';
}

function openCart(){
  const overlay=document.getElementById('cartOverlay');
  const drawer=document.getElementById('cartDrawer');
  if(!overlay||!drawer) return;
  renderCartDrawer();
  overlay.classList.add('open'); drawer.classList.add('open');
  requestAnimationFrame(()=>overlay.classList.add('visible'));
  document.body.style.overflow='hidden';
}
function closeCart(){
  const overlay=document.getElementById('cartOverlay');
  const drawer=document.getElementById('cartDrawer');
  if(!overlay||!drawer) return;
  overlay.classList.remove('visible'); drawer.classList.remove('open');
  setTimeout(()=>overlay.classList.remove('open'),350);
  document.body.style.overflow='';
}

/* ── Checkout ── */
let checkoutStep=1;

function openCheckout(){
  closeCart();
  if(cartItems.length===0) return;
  // Copy logo src to checkout
  const logoSrc=document.querySelector('.hero-logo-img')||document.querySelector('.shf-logo-img');
  const chLogo=document.getElementById('checkoutLogo');
  if(chLogo&&logoSrc) chLogo.src=logoSrc.src;
  checkoutStep=1;
  renderCheckout();
